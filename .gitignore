# Python
__pycache__/
*.pyc
cad_env/

# Generated figures (script outputs — committed as example_*.png instead)
figures/surface__points_cone_plot.png
figures/surface__points_cone_normals_plot.png
figures/side_strip_touch_poses.png
figures/cone_touch_poses.png
# plot_cone_data.py outputs (one set per recording, timestamp-named)
figures/*_force_vs_time.png
figures/*_speed_vs_time.png
figures/*_trajectory_3d.png
figures/*_peak_force_per_press.png
figures/*_press_force_on_cone.png
# Generated data files
*.csv
*.csv.gz
!physical_points.csv
# Tracked on purpose: the sampled STL surface (Step 1 output, small and
# deterministic from cone.STL).
!data/surface_points.csv
# ur5_tactile_data recordings are NOT tracked: trajectory CSVs run tens of MB
# each (one hit GitHub's 50 MB warning threshold), so they stay local/synced
# via sync_cone_data.sh rather than committed.

# ur5_tactile_data batch outputs (regenerated by the batch scripts there from
# the tracked CSVs above, so keeping them out of git avoids re-committing a
# few MB of PNGs/HTML every time a plot is tweaked)
ur5_tactile_data/*/*.png
ur5_tactile_data/*/*.html
ur5_tactile_data/*/*.json

# Robot terminal logs
execution/robot_logs/
